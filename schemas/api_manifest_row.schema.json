{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/api_manifest_row.schema.json",
  "title": "Frozen v2 API Manifest Row",
  "description": "Schema for a row in the frozen official v2 API manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collection_order",
    "run_id",
    "phase",
    "task_id",
    "category",
    "task_set_version",
    "model_set_version",
    "model_condition_id",
    "model_id",
    "api_provider",
    "underlying_provider_pin",
    "run_repetition",
    "rendered_prompt_path",
    "expected_prompt_sha256",
    "collection_status"
  ],
  "properties": {
    "collection_order": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 360}, {"type": "string", "pattern": "^(?:[1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|360)$"}]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "phase": {"const": "final"},
    "task_id": {"type": "string", "pattern": "^(AUTH-FED|PKI-CRYPTO|DOC-BINARY|ENT-INT|DATA-ADV|DIST-OBS)-0[1-5]$"},
    "category": {"enum": ["AUTH-FED", "PKI-CRYPTO", "DOC-BINARY", "ENT-INT", "DATA-ADV", "DIST-OBS"]},
    "task_set_version": {"const": "final-2.0.0"},
    "model_set_version": {"const": "api-model-set-1.0.0"},
    "model_condition_id": {"enum": ["M1", "M2", "M3", "M4"]},
    "model_id": {"enum": ["cohere/north-mini-code:free", "qwen/qwen3.8-27b", "openai/gpt-oss-120b", "nvidia/nemotron-3-ultra-550b-a55b:free"]},
    "api_provider": {"enum": ["OpenRouter", "Groq"]},
    "underlying_provider_pin": {"enum": ["cohere", "nvidia", "not_applicable"]},
    "run_repetition": {"type": "string", "pattern": "^R0[1-3]$"},
    "rendered_prompt_path": {"type": "string", "minLength": 1},
    "expected_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "collection_status": {"const": "pending"}
  }
}
    "collection_order",
