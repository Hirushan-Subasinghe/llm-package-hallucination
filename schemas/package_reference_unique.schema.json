{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/package_reference_unique.schema.json",
  "title": "Unique Normalized Package Reference",
  "description": "A per-response deterministic deduplication of package reference occurrences.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "collection_order", "model_condition_id", "task_id", "category", "normalized_package", "first_occurrence_index", "occurrence_count", "source_types", "extractor_version"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "collection_order": {"type": "integer", "minimum": 1},
    "model_condition_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "normalized_package": {"type": "string", "minLength": 1},
    "first_occurrence_index": {"type": "integer", "minimum": 1},
    "occurrence_count": {"type": "integer", "minimum": 1},
    "source_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["es_import", "require", "dynamic_import", "npm_install", "package_json"]}},
    "extractor_version": {"type": "string", "minLength": 1}
  }
}
