{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/llm-package-hallucination/generation-metadata.schema.json",
  "title": "Cross-workflow generation and technical-attempt metadata",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generation_id": { "type": "string", "pattern": "^generation-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "task_id": { "type": "string", "pattern": "^(AUTH|DB|FILE|API|SEC|LOG)-[0-9]{3}$" },
    "category": { "enum": ["Authentication and Authorization", "Database Connectivity and Integration", "File Handling and Processing", "API Development and Endpoints", "Security Features and Encryption", "Logging and Caching"] },
    "workflow": { "enum": ["ChatGPT Web", "Gemini Web", "Codex CLI", "Antigravity CLI — Gemini"] },
    "interface": { "enum": ["web", "cli"] },
    "run_number": { "type": "integer", "minimum": 1, "maximum": 3 },
    "experiment_condition": { "enum": ["baseline", "persistence"] },
    "generation_timestamp": { "type": "string", "format": "date-time" },
    "raw_output_path": { "type": ["string", "null"], "minLength": 1 },
    "raw_output_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "visible_model_version": { "type": ["string", "null"] },
    "installation_command_generated": { "type": ["boolean", "null"] },

    "attempt_id": { "type": ["string", "null"], "pattern": "^attempt-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "attempt_status": { "enum": ["successful", "failed", null] },
    "failure_category": { "enum": ["process-launch-failure", "generation-timeout-before-start", "local-runner-failure", "authentication-service-failure", "unknown-infrastructure-failure", null] },
    "failure_summary_redacted": { "type": ["string", "null"] },
    "process_exit_code": { "type": ["integer", "null"] },
    "timeout": { "type": ["boolean", "null"] },
    "cli_version": { "type": ["string", "null"] },
    "runner_version": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "canonical_prompt_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "workspace_id": { "type": ["string", "null"] },
    "workspace_provenance": { "enum": ["fresh-temporary", null] },
    "filesystem_access": { "enum": ["isolated-workspace-only", null] },
    "shell_access": { "enum": ["enabled", "disabled", null] },
    "network_policy": { "enum": ["disabled", "restricted", null] },
    "package_install_policy": { "enum": ["blocked-and-recorded", null] },
    "raw_stdout_path": { "type": ["string", "null"] },
    "raw_stderr_path": { "type": ["string", "null"] },
    "files_created": { "type": ["array", "null"], "items": { "type": "string" } },
    "files_modified": { "type": ["array", "null"], "items": { "type": "string" } },
    "files_deleted": { "type": ["array", "null"], "items": { "type": "string" } },
    "commands_attempted": { "type": ["array", "null"], "items": { "type": "string" } },
    "package_install_commands": { "type": ["array", "null"], "items": { "type": "string" } }
  },
  "required": ["generation_id", "task_id", "category", "workflow", "interface", "run_number", "experiment_condition", "generation_timestamp", "raw_output_path", "raw_output_sha256"],
  "allOf": [
    {
      "if": { "properties": { "workflow": { "enum": ["ChatGPT Web", "Gemini Web"] } }, "required": ["workflow"] },
      "then": { "properties": { "interface": { "const": "web" } } },
      "else": { "properties": { "interface": { "const": "cli" } } }
    },
    {
      "if": { "properties": { "attempt_status": { "const": "failed" } }, "required": ["attempt_status"] },
      "then": {
        "properties": { "raw_output_path": { "type": "null" }, "raw_output_sha256": { "type": "null" } },
        "required": ["attempt_id", "failure_category"]
      },
      "else": {
        "properties": {
          "raw_output_path": { "type": "string", "minLength": 1 },
          "raw_output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  ]
}
