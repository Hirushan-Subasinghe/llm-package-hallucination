{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/package_classification_joined_pipe05_v1.schema.json",
  "title": "PIPE-05 response-package classification join record",
  "description": "One record per (run_id, normalized_package), retaining registry, extraction, truncation, and occurrence provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "collection_order", "model_condition_id", "task_id", "category", "normalized_package", "first_occurrence_index", "occurrence_count", "source_types", "extractor_version", "collection_status", "completion_status", "truncated", "response_artifact_path", "validation_status", "registry", "request_url", "http_status", "checked_at", "validator_version", "evidence_summary", "error_type", "retry_count", "source_input_hash", "source_occurrences_hash", "classification", "classification_basis", "adjudication_status", "review_required", "reviewer_id", "reviewed_at", "review_notes", "review_evidence", "review_checks", "classifier_version", "occurrence_evidence"],
  "properties": {
    "run_id": {"type": "string"},
    "collection_order": {"type": "integer", "minimum": 1},
    "model_condition_id": {"type": "string"},
    "task_id": {"type": "string"},
    "category": {"type": "string"},
    "normalized_package": {"type": "string"},
    "first_occurrence_index": {"type": "integer", "minimum": 1},
    "occurrence_count": {"type": "integer", "minimum": 1},
    "source_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "extractor_version": {"type": "string"},
    "collection_status": {"type": "string"},
    "completion_status": {"type": "string"},
    "truncated": {"type": "boolean"},
    "response_artifact_path": {"type": "string"},
    "validation_status": {"enum": ["exists", "not_found", "unresolved"]},
    "registry": {"type": "string"},
    "request_url": {"type": "string"},
    "http_status": {"type": ["integer", "null"]},
    "checked_at": {"type": "string", "format": "date-time"},
    "validator_version": {"type": "string"},
    "evidence_summary": {"type": "string"},
    "error_type": {"type": ["string", "null"]},
    "retry_count": {"type": "integer", "minimum": 0},
    "source_input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_occurrences_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "classification": {"enum": ["VALID", "CONFIRMED_HALLUCINATION", "LEGACY_OR_REMOVED", "AMBIGUOUS", "BUILTIN_OR_LOCAL", null]},
    "classification_basis": {"type": "string"},
    "adjudication_status": {"enum": ["AUTO_VALID", "REVIEW_REQUIRED", "REVIEWED", "VALIDATION_UNRESOLVED"]},
    "review_required": {"type": "boolean"},
    "reviewer_id": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "review_notes": {"type": ["string", "null"]},
    "review_evidence": {"type": "array", "items": {"$ref": "package_classification_pipe05_v1.schema.json#/$defs/reviewEvidence"}},
    "review_checks": {"oneOf": [{"type": "null"}, {"$ref": "package_classification_pipe05_v1.schema.json#/$defs/reviewChecks"}]},
    "classifier_version": {"const": "pipe-05-classifier-1.0.0"},
    "occurrence_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "package_classification_pipe05_v1.schema.json#/$defs/occurrenceEvidence"}}
  }
}
