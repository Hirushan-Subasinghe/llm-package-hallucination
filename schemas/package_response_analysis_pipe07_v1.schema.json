{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/package_response_analysis_pipe07_v1.schema.json",
  "title": "PIPE-07 package/response-level analysis record",
  "description": "PIPE-07 v1.1 row; D037 resolves primary confirmation here without rewriting PIPE-05 research_classification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "collection_order", "model_condition_id", "provider", "model",
    "task_id", "category", "repetition", "collection_status", "completion_status",
    "truncated", "normalized_package", "occurrence_count", "source_types",
    "validation_status", "research_classification", "adjudication_status", "primary_confirmed_hallucination", "primary_confirmation_path", "primary_confirmation_version", "primary_confirmation_source_hash", "pipe05b_adjudication_outcome",
    "metric_eligible", "provenance"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "collection_order": {"type": "integer", "minimum": 1},
    "model_condition_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "repetition": {"type": "string", "minLength": 1},
    "collection_status": {
      "enum": ["completed", "truncated"],
      "description": "Only completed or truncated responses can have extracted package references."
    },
    "completion_status": {"type": ["string", "null"]},
    "truncated": {"type": "boolean"},
    "normalized_package": {"type": "string", "minLength": 1},
    "occurrence_count": {"type": "integer", "minimum": 1},
    "source_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "validation_status": {"enum": ["exists", "not_found", "unresolved"]},
    "research_classification": {
      "enum": ["VALID", "CONFIRMED_HALLUCINATION", "LEGACY_OR_REMOVED", "AMBIGUOUS", "BUILTIN_OR_LOCAL", null]
    },
    "adjudication_status": {"enum": ["AUTO_VALID", "REVIEW_REQUIRED", "REVIEWED", "VALIDATION_UNRESOLVED"]},
    "primary_confirmed_hallucination": {"type": "boolean"},
    "primary_confirmation_path": {"enum": ["PIPE05_REVIEWED", "PIPE05B", "NONE"]},
    "primary_confirmation_version": {"type": ["string", "null"]},
    "primary_confirmation_source_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "pipe05b_adjudication_outcome": {"type": ["string", "null"]},
    "metric_eligible": {
      "type": "boolean",
      "description": "True only when collection_status == 'completed' (frozen truncation-exclusion rule). PHR/SHR are not computed by this dataset; this flag only marks eligibility for a later metric computation."
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "References to the PIPE-03/04/05 evidence that produced this row (extractor/validator/classifier versions, checked_at, adjudication status, response artifact path)."
    }
  }
}
