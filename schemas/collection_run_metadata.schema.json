{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/collection_run_metadata.schema.json",
  "title": "Collection Run Metadata",
  "description": "Operational provenance for one preserved generation run. Pilot and final phase records remain physically separate.",
  "type": "object",
  "required": [
    "run_id",
    "phase",
    "prompt_id",
    "prompt_set_version",
    "category",
    "workflow",
    "tool_name",
    "provider",
    "model_name",
    "model_version",
    "workflow_type",
    "temperature",
    "seed",
    "max_output_tokens",
    "timestamp",
    "prompt_text",
    "prompt_sha256",
    "raw_response_path",
    "raw_response_sha256",
    "collection_method",
    "operator_id",
    "notes",
    "collection_status",
    "artifact_directory",
    "cli_exit_status"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["pilot", "final"]},
    "prompt_id": {"type": "string", "minLength": 1},
    "prompt_set_version": {"const": "1.0.0"},
    "category": {"type": "string", "minLength": 1},
    "workflow": {"enum": ["chatgpt_web", "gemini_web", "codex_cli", "antigravity_cli"]},
    "tool_name": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model_name": {"type": "string", "minLength": 1},
    "model_version": {"type": ["string", "number"]},
    "workflow_type": {"type": "string", "minLength": 1},
    "model_reasoning_effort": {"type": "string"},
    "service_tier": {"type": "string"},
    "temperature": {"oneOf": [{"type": "number"}, {"const": "not_exposed"}]},
    "seed": {"oneOf": [{"type": "integer"}, {"const": "not_exposed"}]},
    "max_output_tokens": {"type": ["integer", "null"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "generation_started_at_utc": {"type": "string", "format": "date-time"},
    "generation_ended_at_utc": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "prompt_text": {"type": "string"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "raw_response_path": {"type": "string"},
    "raw_response_sha256": {"type": "string"},
    "raw_response_size_bytes": {"type": "integer", "minimum": 0},
    "collection_method": {"type": "string", "minLength": 1},
    "operator_id": {"type": "string", "minLength": 1},
    "notes": {"type": "string"},
    "collection_status": {"enum": ["initialized", "running", "captured", "completed", "failed", "error"]},
    "transcript_path": {"type": "string"},
    "transcript_sha256": {"$ref": "#/$defs/sha256"},
    "transcript_size_bytes": {"type": "integer", "minimum": 0},
    "stderr_path": {"type": "string"},
    "stderr_sha256": {"$ref": "#/$defs/sha256"},
    "stderr_size_bytes": {"type": "integer", "minimum": 0},
    "artifact_directory": {"type": "string"},
    "cli_exit_status": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "attempt_number": {"type": "integer", "minimum": 1},
    "codex_cli_version": {"type": "string"},
    "manifest_path": {"type": "string"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "web_search": {"type": "string"},
    "sandbox_mode": {"type": "string"},
    "session_ephemeral": {"type": "boolean"},
    "user_config_ignored": {"type": "boolean"},
    "rules_ignored": {"type": "boolean"},
    "skip_git_repo_check": {"type": "boolean"},
    "disabled_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "invocation_argv": {"type": "array", "items": {"type": "string"}},
    "workspace_isolation": {"type": "string"},
    "codex_home_isolation": {"type": "string"},
    "failure_reason": {"type": "string"},
    "failed_capture": {"type": "object"},
    "finalization_errors": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"collection_method": {"const": "automated_codex_exec"}}},
      "then": {
        "required": [
          "model_reasoning_effort", "service_tier", "generation_started_at_utc",
          "generation_ended_at_utc", "duration_ms", "codex_cli_version", "web_search",
          "sandbox_mode", "session_ephemeral", "user_config_ignored", "rules_ignored",
          "skip_git_repo_check", "disabled_features", "invocation_argv", "workspace_isolation",
          "codex_home_isolation", "timed_out"
        ],
        "properties": {
          "phase": {"const": "pilot"},
          "workflow": {"const": "codex_cli"},
          "tool_name": {"const": "codex_cli"},
          "provider": {"const": "OpenAI"},
          "model_name": {"const": "gpt-5.6-sol"},
          "model_version": {"const": "not_exposed"},
          "workflow_type": {"const": "agentic_cli"},
          "model_reasoning_effort": {"const": "medium"},
          "service_tier": {"const": "default"},
          "temperature": {"const": "not_exposed"},
          "seed": {"const": "not_exposed"},
          "codex_cli_version": {"const": "0.154.0"},
          "web_search": {"const": "disabled"},
          "sandbox_mode": {"const": "read-only"},
          "session_ephemeral": {"const": true},
          "user_config_ignored": {"const": true},
          "rules_ignored": {"const": true},
          "skip_git_repo_check": {"const": true}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
  }
}
