# Python cache/bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
# Local secrets
.env
.env.*
!.env.example
# Logs and generated outputs (keep directory placeholders only)
logs/*
!logs/.gitkeep
results/*
!results/.gitkeep
# Data artifacts (track structure, not collected records)
data/pilot/raw/*
!data/pilot/raw/.gitkeep
data/pilot/extracted/*
!data/pilot/extracted/.gitkeep
data/pilot/validated/*
!data/pilot/validated/.gitkeep
data/final/raw/*
!data/final/raw/.gitkeep
data/final/extracted/*
!data/final/extracted/.gitkeep
data/final/validated/*
!data/final/validated/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/manual_review/*
!data/manual_review/.gitkeep
# Optional local notebooks/checkpoints
.ipynb_checkpoints/
node_modules/
